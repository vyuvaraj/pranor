{
  "name": "pranor-vscode",
  "displayName": "Pranor Platform & Language Tools",
  "description": "Official VS Code extension for the Pranor ecosystem — syntax & LSP support, cluster management, visual service dashboards (Vault, Pulse, Mesh, Gate), chaos testing, and blue/green cloud deployments.",
  "version": "1.0.0",
  "publisher": "vyuvaraj",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:pranor"
  ],
  "main": "./extension.js",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vyuvaraj/Pranor"
  },
  "author": "Yuvaraj",
  "keywords": [
    "pranor",
    "pnr",
    "background services",
    "microservices",
    "scheduler",
    "dsl",
    "syntax highlighting",
    "snippets",
    "lsp",
    "go"
  ],
  "homepage": "https://github.com/vyuvaraj/Pranor",
  "contributes": {
    "languages": [
      {
        "id": "pranor",
        "aliases": [
          "Pranor",
          "pranor"
        ],
        "extensions": [
          ".pnr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pranor",
        "scopeName": "source.pnr",
        "path": "./syntaxes/serv.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pranor",
        "path": "./snippets/serv.code-snippets"
      }
    ],
    "configuration": {
      "title": "Pranor",
      "properties": {
        "pranor.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to the pranor-lsp binary. If empty, looks for 'pranor-lsp' in PATH or workspace root."
        },
        "pranor.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the pranor compiler binary. If empty, looks for 'pranor' or 'pranor.exe' in workspace root or PATH."
        },
        "pranor.enableInlayHints": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred return type and variable type hints inline in the editor."
        },
        "pranor.registryUrl": {
          "type": "string",
          "default": "http://localhost:8090/api/registry/services",
          "description": "The URL of the Pranor Hub microservice to fetch health statuses for the Pranor services sidebar panel."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pranor-services",
          "title": "Pranor",
          "icon": "images/serv-panel.svg"
        }
      ]
    },
    "views": {
      "pranor-services": [
        {
          "id": "pranor-services-panel",
          "name": "Services",
          "type": "webview"
        }
      ],
      "explorer": [
        {
          "id": "pranor-test-explorer",
          "name": "Pranor Tests",
          "when": "workspaceContains:**/*.pnr"
        }
      ]
    },
    "menus": {
      "editor/title/run": [
        {
          "command": "pranor.run",
          "when": "editorLangId == pranor",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "pranor.run",
        "title": "Pranor: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "pranor.build",
        "title": "Pranor: Build Current File",
        "icon": "$(package)"
      },
      {
        "command": "pranor.test",
        "title": "Pranor: Test Current File",
        "icon": "$(beaker)"
      },
      {
        "command": "pranor.watch",
        "title": "Pranor: Run in Watch Mode",
        "icon": "$(eye)"
      },
      {
        "command": "pranor.visualizeWorkflow",
        "title": "Pranor: Visualize DAG Workflow"
      },
      {
        "command": "pranor.exploreQueue",
        "title": "Pranor: Explore Queue Broker"
      },
      {
        "command": "pranor.exploreStore",
        "title": "Pranor: Explore Store Buckets"
      },
      {
        "command": "pranor.exploreLocks",
        "title": "Pranor: Inspect Distributed Locks"
      },
      {
        "command": "pranor.simulateRoute",
        "title": "Pranor: Simulate Route Gateway"
      },
      {
        "command": "pranor.exploreCron",
        "title": "Pranor: Inspect Cron Jobs"
      },
      {
        "command": "pranor.inspectCache",
        "title": "Pranor: Inspect Cache Stats"
      },
      {
        "command": "pranor.inspectAuth",
        "title": "Pranor: Inspect Progressive Auth"
      },
      {
        "command": "pranor.openREPL",
        "title": "Pranor: Launch Interactive REPL"
      },
      {
        "command": "pranor.viewMesh",
        "title": "Pranor: View Service Mesh Topology"
      },
      {
        "command": "pranor.traceRequests",
        "title": "Pranor: Trace Distributed Requests"
      },
      {
        "command": "pranor.viewRegistry",
        "title": "Pranor: View Service Registry Health"
      },
      {
        "command": "pranor.runBench",
        "title": "Pranor: Benchmark Current File"
      },
      {
        "command": "pranor.viewDeployments",
        "title": "Pranor: View Cloud Deployments"
      },
      {
        "command": "pranor.inspectPool",
        "title": "Pranor: Inspect Connection Pool"
      },
      {
        "command": "pranor.inspectMail",
        "title": "Pranor: Inspect Mail Queue"
      },
      {
        "command": "pranor.refreshTests",
        "title": "Pranor: Refresh Test Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "pranor.runTestsWithGutter",
        "title": "Pranor: Run Tests (with Gutter Decorations)",
        "icon": "$(beaker)"
      },
      {
        "command": "pranor.clearTestDecorations",
        "title": "Pranor: Clear Test Gutter Markers"
      },
      {
        "command": "pranor.viewTunnels",
        "title": "Pranor: View Tunnel Sessions"
      },
      {
        "command": "pranor.refreshServices",
        "title": "Pranor: Refresh Services Panel",
        "icon": "$(refresh)"
      },
      {
        "command": "pranor.organizeImports",
        "title": "Pranor: Add Missing Imports"
      },
      {
        "command": "pranor.initProject",
        "title": "Pranor: New Project from Template"
      },
      {
        "command": "pranor.deploy",
        "title": "Pranor: Deploy to Pranor Deploy"
      },
      {
        "command": "pranor.runCoverage",
        "title": "Pranor: Run Tests with Coverage Highlights"
      },
      {
        "command": "pranor.clearCoverage",
        "title": "Pranor: Clear Coverage Highlights"
      },
      {
        "command": "pranor.openPlayground",
        "title": "Pranor: Open Web Playground"
      },
      {
        "command": "pranor.pranorctl",
        "title": "Pranor: pranorctl Cluster Administration"
      },
      {
        "command": "pranor.checkBreakingChanges",
        "title": "Pranor: Check Breaking API Changes (pranor diff)"
      },
      {
        "command": "pranor.generateRust",
        "title": "Pranor: Generate Rust Client Code"
      },
      {
        "command": "pranor.generatePython",
        "title": "Pranor: Generate Python Client Code"
      },
      {
        "command": "pranor.controlChaos",
        "title": "Pranor: Platform Chaos Control Panel"
      },
      {
        "command": "pranor.exportToPlayground",
        "title": "Pranor: Export Current File to WASM Playground"
      },
      {
        "command": "pranor.openPranordConsole",
        "title": "Pranor: Open pranord Unified Platform Console"
      }
    ],
    "keybindings": [
      {
        "command": "pranor.run",
        "key": "ctrl+shift+r",
        "when": "editorLangId == pranor"
      },
      {
        "command": "pranor.build",
        "key": "ctrl+shift+b",
        "when": "editorLangId == pranor"
      },
      {
        "command": "pranor.test",
        "key": "ctrl+shift+t",
        "when": "editorLangId == pranor"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/vyuvaraj/Pranor/issues"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
