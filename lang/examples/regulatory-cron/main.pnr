// Regulatory Cron Service — Entry Point
// Build: pranor build examples/regulatory-cron/main.pnr -o cron-service.exe
// Run from regulatory-cron/ directory: .\cron-service.exe

// Infrastructure
import "./config.pnr"

// Job implementations (self-register via registry.set)
import "./jobs/batch_processing.pnr"
import "./jobs/data_sync.pnr"
import "./jobs/cleanup.pnr"

// Scheduler engine (uses registry.call to dispatch)
import "./scheduler/seeder.pnr"
import "./scheduler/engine.pnr"

// API layer
import "./api/middleware.pnr"
import "./api/jobs.pnr"
import "./api/dlq.pnr"
import "./api/bulk.pnr"
import "./api/stats.pnr"

// Seed sample data on startup if DB is empty
seedIfEmpty()
